# API Configuration
# Base URL for the user service API (backend)
# Example: http://localhost:8080 for local development
# Example: https://api.iqscaffold.com for production
VITE_API_SERVER_URL=http://localhost:8080

# MSW Configuration
# Enable MSW for API mocking in development
# Set to 'false' to disable mocking and use real APIs
VITE_ENABLE_MSW=true

# Log level: 'silent', 'info', 'debug'
# Controls console logging verbosity
VITE_LOG_LEVEL=info

# Authentication Configuration
# Auth domain is where the auth portal is hosted
VITE_AUTH_DOMAIN_AUTH=https://auth.iqscaffold.com
# App domain is where this application is hosted
VITE_AUTH_DOMAIN_APP=https://app.iqscaffold.com

# Auth Redirect Configuration (optional)
# Override default redirect URLs after login/logout/signup
VITE_AUTH_REDIRECT_AFTER_LOGIN=/dashboard
VITE_AUTH_REDIRECT_AFTER_LOGOUT=/
VITE_AUTH_REDIRECT_AFTER_SIGNUP=/verify-email
