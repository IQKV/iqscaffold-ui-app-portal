    "vite-plugin-copy": "^0.1.6",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-remove-console": "^2.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "4.0.18"
  },
  "lint-staged": {
    "*": [
      "pnpm formatter:check"
    ],
    "package.json": [
      "sort-package-json"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@10.31.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
